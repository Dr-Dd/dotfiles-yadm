* {
    font: "monospace 11";
    background-color: transparent;
    text-color: #e6e6e6;
}

window {
    location: north;
    anchor: north;
    y-offset: 30px;
    width: 480px;
    background-color: #000000;
    border: 1px;
    border-color: #1f1f1f;
    border-radius: 8px;
    padding: 6px;
}

mainbox {
    children: [ inputbar, message, listview ];
    spacing: 6px;
}

inputbar {
    padding: 6px 8px;
    children: [ entry ];
}

entry {
    placeholder: "search vault…";
    placeholder-color: #666666;
}

message {
    padding: 0 8px;
}

textbox {
    text-color: #777777;
    font: "monospace 9";
}

listview {
    lines: 7;
    dynamic: true;
    fixed-height: false;
    scrollbar: false;
    spacing: 2px;
}

element {
    padding: 4px 8px;
    border-radius: 5px;
}

element selected.normal {
    background-color: #1c1c1c;
    text-color: #ffffff;
}
